# ============================================================================
# Marowa Store — reference backend environment variables
# ----------------------------------------------------------------------------
# STATUS: Reference only. The static frontend does not read this file and no
# backend is included in this repository. Never commit a real .env file.
# Copy to .env on the server, fill values from a secret manager, and restrict
# filesystem permissions. Use different secrets per environment.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3000
TRUST_PROXY=0
LOG_LEVEL=info

# Comma-separated allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Use a dedicated least-privilege application role, not the database owner.
DATABASE_URL=postgresql://marowa_app:CHANGE_ME@localhost:5432/marowa
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Sessions and passwords ------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_NAME=marowa_sid
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
SESSION_SECURE=true
SESSION_SAME_SITE=lax

# Argon2id tuning: raise memory/time on production hardware after benchmarking.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Optional: require TOTP for these roles.
REQUIRE_2FA_ROLES=owner,manager

# --- Rate limiting and abuse ----------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_READ=180
RATE_LIMIT_QUOTATION=5
RATE_LIMIT_INQUIRY=5
RATE_LIMIT_LOGIN=8
RATE_LIMIT_PASSWORD_RESET=3

# Honeypot/timing checks are internal; CAPTCHA is optional.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# --- Notifications ---------------------------------------------------------
MAIL_FROM="Marowa Store <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
QUOTATION_NOTIFY_TO=staff@example.com
INQUIRY_NOTIFY_TO=staff@example.com

# Optional WhatsApp Business provider (never send without opt-in/templates).
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_QUOTATION=

# --- Uploads / object storage ---------------------------------------------
# UPLOAD_DRIVER: local for single-server development, s3 for production.
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./var/uploads
MAX_UPLOAD_MB=5
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CDN_BASE_URL=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
METRICS_TOKEN=
BACKUP_ALERT_EMAIL=ops@example.com

# --- Privacy / retention ---------------------------------------------------
PRIVACY_CONTACT_EMAIL=privacy@example.com
INQUIRY_RETENTION_DAYS=365
QUOTATION_RETENTION_DAYS=2555
AUDIT_RETENTION_DAYS=3650

# --- One-time bootstrap ----------------------------------------------------
# Prefer a CLI command that reads a password from stdin. If using an env-based
# bootstrap, set these only for the first run, then remove them immediately.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
